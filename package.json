{
  "name": "magic-pixels",
  "version": "6.6.0",
  "description": "A WebGL library",
  "repository": "learosema/magic-pixels",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./draco-worker": "./dist/draco-worker.js",
    "./meshopt-worker": "./dist/meshopt-worker.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:js -s && npm run lint:types -s",
    "lint:js": "eslint src",
    "lint:types": "tsc --noEmit",
    "lint:pkg": "publint",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "node build",
    "build:docs": "typedoc && npm run build:examples -s && cp -R examples site/",
    "build": "rm -rf dist && npm run build:types -s && npm run build:js -s",
    "build:examples": "npm run build:js -s && cp dist/index.js examples/magic-pixels.js && cp dist/draco-worker.js examples/draco-worker.js && cp dist/meshopt-worker.js examples/meshopt-worker.js",
    "prepublishOnly": "npm run lint -s && npm test -s && npm run build && npm run lint:pkg -s"
  },
  "keywords": [
    "webgl",
    "utility-library"
  ],
  "author": "Lea Rosema",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-glsl": "^1.4.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
