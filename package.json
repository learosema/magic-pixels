{
  "name": "magic-pixels",
  "version": "0.0.0-development",
  "description": "A WebGL library",
  "repository": "terabaud/magic-pixels",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint:js -s && npm run lint:types -s",
    "lint:js": "eslint src",
    "lint:types": "tsc --noEmit",
    "lint:pkg": "publint",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "node build",
    "build:docs": "typedoc src/index.ts && touch docs/.nojekyll",
    "build": "rm -rf dist && npm run build:types -s && npm run build:js -s",
    "prepublishOnly": "npm run lint -s && npm test -s && npm run build && npm run lint:pkg -s",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "webgl",
    "utility-library"
  ],
  "author": "Lea Rosema",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@semantic-release/npm": "^13.1.5",
    "esbuild": "^0.28.2",
    "esbuild-plugin-glsl": "^1.4.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {}
}
